[Desktop Entry]
Name=Color Picker
Comment=Pick colors from the screen and convert them between formats
Exec=singularity-colorpicker
Icon=dev.sinty.colorpicker
Terminal=false
Type=Application
Categories=Graphics;Utility;
Keywords=color;colour;picker;pipette;hex;rgb;palette;contrast;
StartupWMClass=dev.sinty.colorpicker
Actions=pick;

[Desktop Action pick]
Name=Pick from Screen
Exec=singularity-colorpicker --pick
